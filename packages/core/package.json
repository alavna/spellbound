{
  "name": "@spellbound/core",
  "version": "0.1.0",
  "description": "Framework-agnostic spell checker and grammar checker engine",
  "keywords": [
    "spell-checker",
    "grammar-checker",
    "typescript",
    "offline"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./algorithms": {
      "import": {
        "types": "./dist/algorithms/index.d.ts",
        "default": "./dist/algorithms/index.js"
      },
      "require": {
        "types": "./dist/algorithms/index.d.cts",
        "default": "./dist/algorithms/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {},
  "sideEffects": false
}
